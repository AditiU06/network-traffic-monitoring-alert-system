{
  "generated_from": "zeek_network_transport_alerts.xlsx",
  "rules": [
    {
      "rule_id": "R01",
      "name": "Scan::Address_Scan",
      "severity": "CRITICAL",
      "origin": "excel",
      "excel_no": 1,
      "log_source": "conn.log",
      "zeek_script": "policy/misc/scan.zeek",
      "trigger_text": "Failed connections to more than 25 unique hosts on one port within 5 min",
      "indicates": "Horizontal scan / worm-like spread",
      "default_behavior": "Notice (when script loaded)",
      "detectors": [
        {
          "type": "window_unique",
          "filter": {
            "proto": "tcp",
            "conn_state": {
              "in": [
                "S0",
                "REJ",
                "RSTOS0"
              ]
            }
          },
          "group_by": [
            "src_ip",
            "dst_port"
          ],
          "unique_field": "dst_ip",
          "window_sec": 300,
          "threshold": 25,
          "op": "gt",
          "report": [
            "src_ip",
            "dst_port"
          ]
        },
        {
          "type": "label",
          "labels": [
            "Scan::Address_Scan"
          ]
        }
      ]
    },
    {
      "rule_id": "R02",
      "name": "Scan::Port_Scan",
      "severity": "CRITICAL",
      "origin": "excel",
      "excel_no": 2,
      "log_source": "conn.log",
      "zeek_script": "policy/misc/scan.zeek",
      "trigger_text": "Failed connections to 15 or more unique ports on one victim within 5 min",
      "indicates": "Vertical scan / reconnaissance",
      "default_behavior": "Notice (when script loaded)",
      "detectors": [
        {
          "type": "window_unique",
          "filter": {
            "proto": "tcp",
            "conn_state": {
              "in": [
                "S0",
                "REJ",
                "RSTOS0"
              ]
            }
          },
          "group_by": [
            "src_ip",
            "dst_ip"
          ],
          "unique_field": "dst_port",
          "window_sec": 300,
          "threshold": 15,
          "op": "ge",
          "report": [
            "src_ip",
            "dst_ip"
          ]
        },
        {
          "type": "label",
          "labels": [
            "Scan::Port_Scan"
          ]
        }
      ]
    },
