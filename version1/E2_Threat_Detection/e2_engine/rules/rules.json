    {
      "rule_id": "S01",
      "name": "SYN flood",
      "severity": "HIGH",
      "trigger_text": "100 or more SYN-only connection attempts from one source to one destination port within 10 s",
      "indicates": "Denial of service by SYN flooding",
      "detectors": [
        {
          "type": "window_combo",
          "window_sec": 10,
          "components": [
            {
              "filter": {
                "proto": "tcp",
                "tcp_flags": {
                  "equals_any": [
                    "S"
                  ]
                }
              },
              "key_fields": [
                "src_ip",
                "dst_ip",
                "dst_port"
              ],
              "min_count": 100
            }
          ]
        },
        {
          "type": "window_combo",
          "window_sec": 10,
          "components": [
            {
              "filter": {
                "proto": "tcp",
                "conn_state": "S0"
              },
              "key_fields": [
                "src_ip",
                "dst_ip",
                "dst_port"
              ],
              "min_count": 100
            }
          ]
        }
