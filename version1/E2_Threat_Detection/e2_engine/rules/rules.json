    {
      "rule_id": "R14",
      "name": "Traceroute::Detected",
      "severity": "HIGH",
      "origin": "excel",
      "excel_no": 14,
      "log_source": "icmp / traceroute.log",
      "zeek_script": "policy/misc/detect-traceroute/main.zeek",
      "trigger_text": "Low-TTL packets (TTL < 10) plus 3 or more ICMP Time Exceeded messages for a src-dst pair within 3 min",
      "indicates": "Network mapping",
      "default_behavior": "Notice (when script loaded)",
      "detectors": [
        {
          "type": "window_combo",
          "window_sec": 180,
          "components": [
            {
              "filter": {
                "ttl": {
                  "lt": 10
                }
              },
              "key_fields": [
                "src_ip"
              ],
              "key_as": [
                "src_ip"
              ],
              "min_count": 1
            },
            {
              "filter": {
                "proto": [
                  "icmp",
                  "icmp6",
                  "icmpv6"
                ],
                "icmp_type": {
                  "in": [
                    11,
                    3
                  ]
                }
              },
              "key_fields": [
                "dst_ip"
              ],
              "key_as": [
                "src_ip"
              ],
              "min_count": 3
            }
          ]
        },
        {
          "type": "label",
          "labels": [
            "Traceroute::Detected"
          ]
        }
      ]
    },
